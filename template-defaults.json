{
  "Aegra PostgreSQL": {
    "POSTGRES_DB": "aegra",
    "POSTGRES_PASSWORD": "${{secret(48)}}",
    "POSTGRES_USER": "aegra"
  },
  "Aegra Redis": {
    "REDIS_PASSWORD": "${{secret(48)}}"
  },
  "Aegra": {
    "AEGRA_CONFIG": "/app/aegra.json",
    "AEGRA_API_KEY": "${{secret(48)}}",
    "AUTH_TYPE": "custom",
    "CRON_ENABLED": "true",
    "DB_ECHO_LOG": "false",
    "DEBUG": "false",
    "ENABLE_PROMETHEUS_METRICS": "false",
    "ENV_MODE": "PRODUCTION",
    "HOST": "0.0.0.0",
    "LANGGRAPH_MAX_POOL_SIZE": "10",
    "LANGGRAPH_MIN_POOL_SIZE": "2",
    "LOG_LEVEL": "INFO",
    "N_JOBS_PER_WORKER": "4",
    "OTEL_CONSOLE_EXPORT": "false",
    "OTEL_TARGETS": "",
    "PORT": "2026",
    "POSTGRES_DB": "${{Aegra PostgreSQL.POSTGRES_DB}}",
    "POSTGRES_HOST": "${{Aegra PostgreSQL.RAILWAY_PRIVATE_DOMAIN}}",
    "POSTGRES_PASSWORD": "${{Aegra PostgreSQL.POSTGRES_PASSWORD}}",
    "POSTGRES_PORT": "5432",
    "POSTGRES_USER": "${{Aegra PostgreSQL.POSTGRES_USER}}",
    "REDIS_BROKER_ENABLED": "true",
    "REDIS_URL": "redis://:${{Aegra Redis.REDIS_PASSWORD}}@${{Aegra Redis.RAILWAY_PRIVATE_DOMAIN}}:6379/0",
    "SERVER_URL": "https://${{Aegra.RAILWAY_PUBLIC_DOMAIN}}",
    "SQLALCHEMY_MAX_OVERFLOW": "5",
    "SQLALCHEMY_POOL_SIZE": "5",
    "WORKER_COUNT": "2"
  }
}
